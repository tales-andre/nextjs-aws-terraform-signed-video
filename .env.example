# Copy to .env.local, or run `npm run setup` to generate it with a fresh key pair.
# Placeholders only. On AWS these come from the ECS task definition and SSM (see infra/app.tf).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
STUDENT_PASSWORD=change-me-student
ADMIN_PASSWORD=change-me-admin
# Where signed video URLs point: the local edge, or https://<distribution>.cloudfront.net on AWS
VIDEO_BASE_URL=http://localhost:4001
CF_KEY_PAIR_ID=K2LOCALDEMOKEY
CF_PRIVATE_KEY_FILE=.local/keys/cloudfront-private.pem
# CF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CF_PUBLIC_KEY_FILE=.local/keys/cloudfront-public.pem
# CF_HASH_ALGORITHM=SHA1   # or SHA256
SIGNED_URL_TTL_SECONDS=60
STORAGE_DRIVER=local
STORAGE_DIR=./storage/data
# STORAGE_DRIVER=s3
# S3_BUCKET=
# AWS_REGION=us-east-1
MAX_UPLOAD_MB=20
